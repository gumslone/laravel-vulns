{
    "name": "gumslone/laravel-vulns",
    "description": "Multi-source vulnerability lookups for PHP and Laravel — OSV, NVD, GitHub Advisories, MITRE, EUVD, CVE-Search, Red Hat, Shodan CVEDB, OSS Index, VulnCheck and Snyk behind one contract, with CVSS v2/v3/v4, EPSS/KEV enrichment, change detection and a self-audit command.",
    "keywords": [
        "vulnerability",
        "cve",
        "osv",
        "nvd",
        "sca",
        "security",
        "cvss",
        "epss",
        "kev",
        "ghsa",
        "advisory",
        "audit",
        "sarif",
        "laravel"
    ],
    "homepage": "https://github.com/gumslone/laravel-vulns",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "gumslone",
            "email": "gumslone@i.ua"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/collections": "^11.0 || ^12.0 || ^13.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "gumslone/laravel-package-url": "^1.2",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Gumslone\\Vulns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gumslone\\Vulns\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gumslone\\Vulns\\VulnsServiceProvider"
            ],
            "aliases": {
                "Vulns": "Gumslone\\Vulns\\Facades\\Vulns"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse --no-progress --memory-limit=1G",
        "lint": "pint --test",
        "fix": "pint",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "gumslone/laravel-package-url": "Convert download/release/archive/registry URLs into searchable coordinates (PackageData::fromUrl, VulnSearch::searchUrl)"
    }
}
